# 复制为 server/.env 后填写；.env 不进版本库。
# 不填 MP_WORKSPACE 时，默认索引仓库里的 workspace-sample/。
MP_WORKSPACE=

MP_HOST=127.0.0.1
MP_PORT=4310
MP_DB=

MP_PROVIDER=deepseek
MP_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MP_THINKING=off

MP_MAX_TURNS=12
MP_MAX_OUTPUT_TOKENS=8192
MP_ALLOW_REVEAL=1
MP_INDEX_ON_START=1

# P1 写操作：默认开启，但每个写/删动作都必须经过用户确认。
MP_ALLOW_WRITES=1
MP_CONFIRM_TIMEOUT_MS=120000
MP_MAX_DESTRUCTIVE=3

# RAG 阶段 2：本地向量。MP_EMBED=0 完全关闭语义检索，只走关键词。
MP_EMBED=1
MP_EMBED_MODEL=Xenova/bge-base-zh-v1.5
MP_EMBED_CACHE=
MP_EMBED_DTYPE=q8
# 删除只进系统废纸篓；测试或隔离环境可以指到别的目录。
MP_TRASH_DIR=

MP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
